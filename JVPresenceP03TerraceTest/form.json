{
  "elements": [
    {
      "type": "Label",
      "caption": "P03 Portal HOME ↔ Lagerplatz. Ausschließlicher Grenzbeweis: Reihenfolge der beiden Mastkameras. JV Terrasse/CrossLine ist optional und hat keine Proof-/Zonenwirkung."
    },
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "P03-Modul aktiv"
    },
    {
      "type": "ExpansionPanel",
      "caption": "P03 Kameras / direkte Dahua-Verbindung",
      "expanded": true,
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "TerraceHost",
          "caption": "JV Terrasse – IP (optional, nur Diagnose)"
        },
        {
          "type": "NumberSpinner",
          "name": "CameraPort",
          "caption": "Dahua HTTP-Port",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "ValidationTextBox",
          "name": "Username",
          "caption": "Dahua Benutzername"
        },
        {
          "type": "PasswordTextBox",
          "name": "Password",
          "caption": "Dahua Passwort"
        },
        {
          "type": "ValidationTextBox",
          "name": "AuxJVHost",
          "caption": "Lagerplatz JV links – IP"
        },
        {
          "type": "ValidationTextBox",
          "name": "AuxWorkHost",
          "caption": "Lagerplatz Werkstatt links – IP"
        },
        {
          "type": "Label",
          "caption": "Pflicht: JV links 192.168.107.96 und Werkstatt links 192.168.107.99. P03 legt für beide eigene Human-IVS-Regeln und eigene Eventstream-Observer an. Terrasse 192.168.107.110 ist optional."
        },
        {
          "type": "Label",
          "caption": "AussenlichtAutomatik2 bleibt vollständig unabhängig: keine Instanz wird aufgerufen, geändert oder neu gestartet."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "P03 Beweislogik",
      "expanded": true,
      "items": [
        {
          "type": "NumberSpinner",
          "name": "NearProofWindowSeconds",
          "caption": "Max. Zeit zwischen beiden Mastkameras (s)",
          "minimum": 5,
          "maximum": 120
        },
        {
          "type": "Label",
          "caption": "JV_LEFT → WORK_LEFT = HOME→LAGER. WORK_LEFT → JV_LEFT = LAGER→HOME."
        },
        {
          "type": "Label",
          "caption": "Nur zwei aufeinanderfolgende Personenerkennungen verschiedener Mastkameras innerhalb des Zeitfensters erzeugen einen Übergang."
        },
        {
          "type": "Label",
          "caption": "Nur eine Kamera, dieselbe Kamera zweimal, gleichzeitige Erkennung, zu großer Abstand oder schnelle Gegenrichtung = kein Übergang."
        },
        {
          "type": "Label",
          "caption": "Terrassen-Human und Terrassen-CrossLine werden nicht in den Proof-Puffer übernommen und dürfen den Übergangszähler nicht erhöhen."
        },
        {
          "type": "Label",
          "caption": "Produktfreigabe erst nach erfolgreichem Mastkamera-Audit/Simulation und mindestens 2× HOME→LAGER + 2× LAGER→HOME."
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "P03 Gesamtaudit – 2 Mastkameras (Terrasse optional)",
      "onClick": "JVP03MC_AuditCameraConfiguration($id);"
    },
    {
      "type": "Button",
      "caption": "Interne P03 Simulation ausführen",
      "onClick": "JVP03MC_RunP03Simulation($id);"
    },
    {
      "type": "Button",
      "caption": "P03 Kamera-Observer neu suchen / prüfen",
      "onClick": "JVP03MC_P03AuxRescan($id);"
    },
    {
      "type": "Button",
      "caption": "P03 2-Kamera-Lauftest vorbereiten & starten",
      "onClick": "JVP03MC_PrepareAndStartTest($id);"
    },
    {
      "type": "Button",
      "caption": "P03 Produktivbetrieb aktivieren",
      "onClick": "JVP03MC_EnableProductionP03($id);"
    },
    {
      "type": "Button",
      "caption": "P03 Produktivbetrieb deaktivieren / Testkonfiguration zurücksetzen",
      "onClick": "JVP03MC_DisableProductionP03($id);"
    },
    {
      "type": "Button",
      "caption": "Testzustand zurücksetzen",
      "onClick": "JVP03MC_ResetTest($id);"
    },
    {
      "type": "Button",
      "caption": "Optional: Terrassen-Diagnosestream neu aufbauen",
      "onClick": "JVP03MC_Reconnect($id);"
    },
    {
      "type": "Button",
      "caption": "Zustand ins Debug schreiben",
      "onClick": "JVP03MC_DumpState($id);"
    }
  ]
}
