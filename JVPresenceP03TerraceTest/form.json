{
  "elements": [
    {
      "type": "Label",
      "caption": "P03 HOME ↔ Lagerplatz: Der Grenzübertritt wird ausschließlich aus der Reihenfolge der beiden Lagerplatzkameras bestimmt. Das P03-Hauptmodul benötigt keine übergeordnete Schnittstelle."
    },
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "P03-Modul aktiv"
    },
    {
      "type": "ExpansionPanel",
      "caption": "P03 Mastkameras – Primärsensoren",
      "expanded": true,
      "items": [
        {
          "type": "NumberSpinner",
          "name": "CameraPort",
          "caption": "Dahua HTTP-Port",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "ValidationTextBox",
          "name": "Username",
          "caption": "Dahua Benutzername"
        },
        {
          "type": "PasswordTextBox",
          "name": "Password",
          "caption": "Dahua Passwort"
        },
        {
          "type": "ValidationTextBox",
          "name": "AuxJVHost",
          "caption": "JV_LEFT – Lagerplatz JV links"
        },
        {
          "type": "ValidationTextBox",
          "name": "AuxWorkHost",
          "caption": "WORK_LEFT – Lagerplatz Werkstatt links"
        },
        {
          "type": "Label",
          "caption": "Standard: JV_LEFT 192.168.107.96, WORK_LEFT 192.168.107.99. P03 besitzt dafür eigene interne Observer und eigene Human-IVS-Regeln. AussenlichtAutomatik2 wird nicht verwendet oder verändert."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "P03 Beweislogik",
      "expanded": true,
      "items": [
        {
          "type": "NumberSpinner",
          "name": "NearProofWindowSeconds",
          "caption": "Max. Zeit zwischen beiden Mastkameras (s)",
          "minimum": 5,
          "maximum": 120
        },
        {
          "type": "Label",
          "caption": "JV_LEFT → WORK_LEFT innerhalb des Zeitfensters = HOME→LAGER."
        },
        {
          "type": "Label",
          "caption": "WORK_LEFT → JV_LEFT innerhalb des Zeitfensters = LAGER→HOME."
        },
        {
          "type": "Label",
          "caption": "Nur eine Kamera, dieselbe Kamera mehrfach, unklare Gegenrichtung oder zu großer Zeitabstand = kein Übergang."
        },
        {
          "type": "Label",
          "caption": "Intern wird jeder Human-IVS-Treffer über einen Ereigniszähler erfasst; der sichtbare Boolean „Person erkannt“ ist nur Diagnose."
        },
        {
          "type": "Label",
          "caption": "Produktfreigabe erst nach mindestens 2× HOME→LAGER und 2× LAGER→HOME."
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "P03 Mastkamera-Audit – 2 Kameras (kein Lauftest)",
      "onClick": "JVP03MC_AuditCameraConfiguration($id);"
    },
    {
      "type": "Button",
      "caption": "Interne P03 2-Kamera-Simulation ausführen",
      "onClick": "JVP03MC_RunP03Simulation($id);"
    },
    {
      "type": "Button",
      "caption": "P03 Mastkamera-Observer neu suchen / prüfen",
      "onClick": "JVP03MC_P03AuxRescan($id);"
    },
    {
      "type": "Button",
      "caption": "P03 2-Kamera-Lauftest vorbereiten & starten",
      "onClick": "JVP03MC_PrepareAndStartTest($id);"
    },
    {
      "type": "Button",
      "caption": "P03 Produktivbetrieb aktivieren",
      "onClick": "JVP03MC_EnableProductionP03($id);"
    },
    {
      "type": "Button",
      "caption": "P03 Produktivbetrieb deaktivieren / Testkonfiguration zurücksetzen",
      "onClick": "JVP03MC_DisableProductionP03($id);"
    },
    {
      "type": "Button",
      "caption": "Testzustand zurücksetzen",
      "onClick": "JVP03MC_ResetTest($id);"
    },
    {
      "type": "Button",
      "caption": "Zustand ins Debug schreiben",
      "onClick": "JVP03MC_DumpState($id);"
    }
  ]
}
