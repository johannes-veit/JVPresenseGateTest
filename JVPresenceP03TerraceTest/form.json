{
  "elements": [
    {
      "type": "Label",
      "caption": "P03 HOME ↔ LAGER: JV links + Werkstatt links. Person erkannt = SMD-Status (5 Sekunden); nur bestätigte Treppen-CrossLine-Human-Ereignisse zählen als Übertritt. TEST/PRODUKTION nur nach sicherem Gehtest."
    },
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "P03-Modul aktiv"
    },
    {
      "type": "ExpansionPanel",
      "caption": "P03 Übertrittslogik",
      "expanded": true,
      "items": [
        {
          "type": "NumberSpinner",
          "name": "CameraPort",
          "caption": "Dahua HTTP-Port",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "Label",
          "caption": "Kameras durch Weboberfläche bestätigt: JV_LEFT=192.168.107.95, WORK_LEFT=192.168.107.94. 192.168.107.96 und .99 sind die RECHTEN Kameras und dürfen NICHT als Mastkameras verwendet werden. Nur bestehende P03-Observer/Sockets; keine Kamera-/IVS-Änderungen."
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "1. Verbindungen und Personenerkennung prüfen (Bericht #35115)",
      "onClick": "JVP03MC_DiagnoseP03Connections($id);"
    },
    {
      "type": "Button",
      "caption": "2. Kamera-IVS-Konfiguration nur lesen (Bericht #35115)",
      "onClick": "JVP03MC_DiagnoseIPC5442Configuration($id);"
    },
    {
      "type": "Button",
      "caption": "3. Treppen-CrossLine-Zuordnung neu prüfen (nur lesen)",
      "onClick": "JVP03MC_AuditCameraConfiguration($id);"
    },
    {
      "type": "Button",
      "caption": "4. Interne 2-Kamera-Simulation",
      "onClick": "JVP03MC_RunP03Simulation($id);"
    },
    {
      "type": "Button",
      "caption": "5. Kontrollierten Gehtest starten",
      "onClick": "JVP03MC_PrepareAndStartTest($id);"
    },
    {
      "type": "Button",
      "caption": "6. Produktion aktivieren (nur bei vollständigem Nachweis)",
      "onClick": "JVP03MC_EnableProductionP03($id);"
    },
    {
      "type": "Button",
      "caption": "Test / Produktion stoppen",
      "onClick": "JVP03MC_DisableProductionP03($id);"
    }
  ]
}
