{
  "elements": [
    {
      "type": "Label",
      "caption": "P03 Portal HOME ↔ Lagerplatz. Der Grenzübertritt wird ausschließlich aus der zeitlichen Reihenfolge der beiden Lagerplatzkameras ermittelt. Terrasse/CrossLine dient nur als Zusatzdiagnose."
    },
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "P03-Modul aktiv"
    },
    {
      "type": "ExpansionPanel",
      "caption": "P03 Kameras / direkte Dahua-Verbindung",
      "expanded": true,
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "TerraceHost",
          "caption": "JV Terrasse – IP"
        },
        {
          "type": "NumberSpinner",
          "name": "CameraPort",
          "caption": "Dahua HTTP-Port",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "ValidationTextBox",
          "name": "Username",
          "caption": "Dahua Benutzername"
        },
        {
          "type": "PasswordTextBox",
          "name": "Password",
          "caption": "Dahua Passwort"
        },
        {
          "type": "ValidationTextBox",
          "name": "AuxJVHost",
          "caption": "Lagerplatz JV links – IP"
        },
        {
          "type": "ValidationTextBox",
          "name": "AuxWorkHost",
          "caption": "Lagerplatz Werkstatt links – IP"
        },
        {
          "type": "Label",
          "caption": "Standard: Terrasse 192.168.107.110, JV links 192.168.107.96, Werkstatt links 192.168.107.99. Für die beiden Mastkameras legt P03 eigene interne Kamera-Observer und eigene Human-IVS-Regeln an."
        },
        {
          "type": "Label",
          "caption": "AussenlichtAutomatik2 bleibt vollständig unabhängig und wird von P03 nicht verwendet."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "P03 Beweislogik",
      "expanded": true,
      "items": [
        {
          "type": "NumberSpinner",
          "name": "NearProofWindowSeconds",
          "caption": "Max. Zeit zwischen beiden Mastkameras (s)",
          "minimum": 5,
          "maximum": 120
        },
        {
          "type": "Label",
          "caption": "Primärlogik: JV_LEFT → WORK_LEFT = HOME→LAGER. WORK_LEFT → JV_LEFT = LAGER→HOME."
        },
        {
          "type": "Label",
          "caption": "Nur wenn beide Kameras nacheinander innerhalb des Zeitfensters eine Person erkennen, wird ein Grenzübertritt gebucht."
        },
        {
          "type": "Label",
          "caption": "Nur eine Kamera, dieselbe Kamera zweimal, gleichzeitige/unklare Gegenrichtung oder zu großer Zeitabstand = kein Übergang."
        },
        {
          "type": "Label",
          "caption": "JV Terrasse und ihre CrossLine sind nur Zusatzdiagnose und dürfen niemals eine der beiden Mastkameras ersetzen."
        },
        {
          "type": "Label",
          "caption": "Produktfreigabe erst nach mindestens 2× HOME→LAGER und 2× LAGER→HOME."
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "P03 Gesamtaudit – 3 Kameras (kein Lauftest)",
      "onClick": "JVP03MC_AuditCameraConfiguration($id);"
    },
    {
      "type": "Button",
      "caption": "Interne P03 Simulation ausführen",
      "onClick": "JVP03MC_RunP03Simulation($id);"
    },
    {
      "type": "Button",
      "caption": "P03 Kamera-Observer neu suchen / prüfen",
      "onClick": "JVP03MC_P03AuxRescan($id);"
    },
    {
      "type": "Button",
      "caption": "P03 Mehrkamera-Test vorbereiten & starten",
      "onClick": "JVP03MC_PrepareAndStartTest($id);"
    },
    {
      "type": "Button",
      "caption": "P03 Produktivbetrieb aktivieren",
      "onClick": "JVP03MC_EnableProductionP03($id);"
    },
    {
      "type": "Button",
      "caption": "P03 Produktivbetrieb deaktivieren / Testkonfiguration zurücksetzen",
      "onClick": "JVP03MC_DisableProductionP03($id);"
    },
    {
      "type": "Button",
      "caption": "Testzustand zurücksetzen",
      "onClick": "JVP03MC_ResetTest($id);"
    },
    {
      "type": "Button",
      "caption": "Terrassen-Eventstream neu aufbauen",
      "onClick": "JVP03MC_Reconnect($id);"
    },
    {
      "type": "Button",
      "caption": "Zustand ins Debug schreiben",
      "onClick": "JVP03MC_DumpState($id);"
    }
  ]
}
